# Pocket Mentor Frontend - Environment Configuration Template
# In Vite, all client-exposed environment variables must begin with VITE_

# API Backend Base URL
# - If running Unified Mode (Express serves the built React frontend on the same domain/port):
#   Leave blank or omitted; the app defaults to relative '/api'.
# - If running Split Mode (Frontend on Vercel/Netlify, Backend on Render/Railway):
#   Set this to your backend domain:
#   VITE_API_URL=https://pocket-mentor-api.onrender.com
VITE_API_URL=

# Socket.io Server Base URL
# - If running Unified Mode:
#   Leave blank or omitted; the app connects to the same origin.
# - If running Split Mode:
#   Set this to your backend domain:
#   VITE_SOCKET_URL=https://pocket-mentor-api.onrender.com
VITE_SOCKET_URL=
