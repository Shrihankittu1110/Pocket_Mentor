# Pocket Mentor Backend - Environment Configuration Template
# Duplicate this file to .env and fill in your actual values.

# Server Port (PaaS hosts like Render/Railway automatically inject PORT)
PORT=5000

# Environment Mode: development or production
NODE_ENV=production

# MongoDB Connection String
# For local development: mongodb://127.0.0.1:27017/pocket-mentor
# For cloud production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pocket-mentor?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pocket-mentor?retryWrites=true&w=majority

# JWT Secret Key (Generate a random 64-character secret in production)
JWT_SECRET=your_super_strong_production_jwt_secret_key_here

# Allowed Client Origin(s) for CORS and Socket.io
# Leave blank or set to your frontend domain in production.
# Multiple domains can be separated with a comma, e.g.:
# CLIENT_URL=https://pocket-mentor.vercel.app,https://pocketmentor.com
CLIENT_URL=http://localhost:5173

# Google Gemini AI API Key (Optional: Pocket Mentor includes built-in offline algorithmic study generators if omitted)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Alternative key variable name (both are supported):
AI_API_KEY=
